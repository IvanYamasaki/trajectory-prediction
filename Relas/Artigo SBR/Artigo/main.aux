\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Temporal degradation (color = model, line style = horizon). (a) Mean ADE per year. (b) Percentage increase in ADE relative to 2019. (c) $\mathrm  {p99}/\mathrm  {p50}$ ratio of the per-trajectory ADE: the 2021 jump is a tail effect ($4.36 \to 4.94$), whereas in 2022--2025 the ratio falls below baseline while the median rises by about 25\,\%.}}{2}{figure.1}\protected@file@percent }
\newlabel{fig:degradation}{{1}{2}{Temporal degradation (color = model, line style = horizon). (a) Mean ADE per year. (b) Percentage increase in ADE relative to 2019. (c) $\mathrm {p99}/\mathrm {p50}$ ratio of the per-trajectory ADE: the 2021 jump is a tail effect ($4.36 \to 4.94$), whereas in 2022--2025 the ratio falls below baseline while the median rises by about 25\,\%}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Kinematic drift. \chg {(a) KS statistic per year against the 2019 baseline (lines: annual mean; dots: matches). (b) Wasserstein distance indexed to the 2019 level.} (c) Mean ADE per match against the match's \texttt  {accel\_p99}, with a regression line and a 95\,\% bootstrap band.}}{2}{figure.2}\protected@file@percent }
\newlabel{fig:kinematic}{{2}{2}{Kinematic drift. \protect \chg {(a) KS statistic per year against the 2019 baseline (lines: annual mean; dots: matches). (b) Wasserstein distance indexed to the 2019 level.} (c) Mean ADE per match against the match's \texttt {accel\_p99}, with a regression line and a 95\,\% bootstrap band}{figure.2}{}}
