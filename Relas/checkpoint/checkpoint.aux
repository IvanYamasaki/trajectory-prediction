\@writefile{toc}{\contentsline {paragraph}{Resultado central do Pelt --- mBIC monot\^onico.}{22}{subsection.3.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Re-an\'alise offline (M\^es~6) usando crit\'erio formal \cite  {killick2012}. \textbf  {Topo:} a curva mBIC \'e monotonicamente crescente em $K$, indicando que $K^*\!=\!0$ \emph  {breakpoints} \'e a solu\c {c}\~ao BIC-\'otima. \textbf  {Embaixo:} a estabilidade de $n_\mathrm  {bps}\!=\!2$ ao $\gamma $ do kernel RBF (3 fatores testados: $0{,}1\times $, $1\times $, $10\times $) e a transi\c {c}\~ao para $0$ em \texttt  {pen}\,$\geq \!30$ confirmam que o resultado de 2 breakpoints \'e propriedade da escala de penalidade, n\~ao do sinal. \textbf  {Conclus\~ao formal:} n\~ao h\'a evid\^encia estat\'istica de breakpoints ao n\'ivel de 36 jogos. Fontes: \texttt  {ruptures\_bic\_curve.csv}, \texttt  {ruptures\_gamma\_sensitivity.csv}.}}{23}{figure.caption.13}\protected@file@percent }
\newlabel{fig:m2_bic}{{10}{23}{Re-an\'alise offline (M\^es~6) usando crit\'erio formal \cite {killick2012}. \textbf {Topo:} a curva mBIC \'e monotonicamente crescente em $K$, indicando que $K^*\!=\!0$ \emph {breakpoints} \'e a solu\c {c}\~ao BIC-\'otima. \textbf {Embaixo:} a estabilidade de $n_\mathrm {bps}\!=\!2$ ao $\gamma $ do kernel RBF (3 fatores testados: $0{,}1\times $, $1\times $, $10\times $) e a transi\c {c}\~ao para $0$ em \texttt {pen}\,$\geq \!30$ confirmam que o resultado de 2 breakpoints \'e propriedade da escala de penalidade, n\~ao do sinal. \textbf {Conclus\~ao formal:} n\~ao h\'a evid\^encia estat\'istica de breakpoints ao n\'ivel de 36 jogos. Fontes: \texttt {ruptures\_bic\_curve.csv}, \texttt {ruptures\_gamma\_sensitivity.csv}}{figure.caption.13}{}}
